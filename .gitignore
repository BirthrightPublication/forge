/htmlcov/

# Local credentials. Example templates may be committed after review.
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.aws/
/.ssh/
/credentials.json
/credentials.local.json
/cookies.txt
/cookies.json
/token.json
/tokens.json
/secrets.json

# Application state, private inputs/outputs, installed engines and model caches.
# Root-scoped paths keep future forge modules and intentional test fixtures visible.
/data/
/forge-data/
/private/
/private-media/
/media-inputs/
/exports/
/output/
/outputs/
/staging/
/work/
/models/
/tools/
/logs/
/runtime.json
/Config/
/settings.json
/config.json
/config.local.*
/service.log
/*.sqlite3*
/*.sqlite*
/*.db
/*.db-*
/*.forge-fingerprint.json
/.forge-*
/update-last.json

# Generated installations, packaging products and updater backups.
/FORGE.exe
/installed-versions.txt
/Build/
/Backups/
/Update-Backups/
/Update-Logs/
/UserData/
/user-data/
/userdata/
/Settings/
/settings/
/Presets/
/presets/
/Queue/
/queue/
/History/
/history/
/build/
/dist/
/releases/
/*.egg-info/
/*.whl
/*.zip
/*.bundle
/FORGE-*.tar.gz

# Machine-specific Windows shortcut metadata is never source material.
*.[lL][nN][kK]

# Loose local media inputs belong outside the source tree. Test fixtures remain visible.
/*.mp4
/*.mkv
/*.mov
/*.webm
/*.avi
/*.m4v
/*.wav
/*.mp3
/*.flac
/*.m4a
/*.ogg
/*.aac
/*.wma
/*.aiff
/*.aif

# Managed maintenance state belongs in FORGE_DATA_DIR, never in source.
/maintenance/
/cuda-health.json
/.forge-maintenance.json
/.forge-maintenance.lock
