# Local Python/JavaScript environments and dependency caches.
/.venv*/
/venv/
/venv-*/
/env/
/node_modules/
/.cache/
/.pip-cache/
/pip-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/

# Local credentials. Example templates may be committed after review.
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.aws/
/.ssh/
/credentials.json
/credentials.local.json
/cookies.txt
/cookies.json
/token.json
/tokens.json
/secrets.json

# Application state, private inputs/outputs, installed engines and model caches.
# Root-scoped paths keep future forge modules and intentional test fixtures visible.
/data/
/forge-data/
/private/
/private-media/
/media-inputs/
/exports/
/output/
/outputs/
/staging/
/work/
/models/
/tools/
/logs/
/runtime.json
/service.log
/*.sqlite3*
/*.forge-fingerprint.json
/.forge-*
/update-last.json

# Generated installations, packaging products and updater backups.
/FORGE.exe
/installed-versions.txt
/Build/
/Backups/
/build/
/dist/
/releases/
/*.egg-info/
/*.whl
/*.zip
/FORGE-*.tar.gz

# Machine-specific Windows shortcut metadata is never source material.
*.[lL][nN][kK]
